import sympy as sp
import pytest

from core import MathEngine
from core.errors import DimensionError
from units.dimensions import LENGTH, TIME
from units.quantities import SymbolicQuantity


def test_three_level_function_chain():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.lines = [
        "f(x) = x**2",
        "g(x) = f(x) + x**2",
        "h(x) = g(x) * x",
    ]
    engine._rebuild()

    result = engine.call("h", engine.variables.get("x"))

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == LENGTH**3
    assert sp.simplify(result.expression - 3 * sp.Symbol("x")**3) == 0


def test_deep_chain_with_default_arguments():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.lines = [
        "f(x, k=2) = k*x",
        "g(x, a=3) = f(x, a)",
        "h(x) = g(x) + f(x)",
    ]
    engine._rebuild()

    result = engine.call("h", engine.variables.get("x"))

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == LENGTH
    assert sp.simplify(result.expression - 5 * sp.Symbol("x")) == 0


def test_deep_chain_with_overridden_arguments():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.lines = [
        "f(x, k=2) = k*x",
        "g(x, a=3) = f(x, a)",
        "h(x, b=4) = g(x, b) + f(x, b)",
    ]
    engine._rebuild()

    result = engine.call("h", engine.variables.get("x"), 5)

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == LENGTH
    assert sp.simplify(result.expression - 10 * sp.Symbol("x")) == 0


def test_global_variables_at_different_levels():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.set_symbolic_variable("a", "a", LENGTH)
    engine.set_symbolic_variable("b", "b", LENGTH)
    engine.lines = [
        "f(x) = x + a",
        "g(x) = f(x) + b",
        "h(x) = g(x) * x",
    ]
    engine._rebuild()

    result = engine.call("h", engine.variables.get("x"))

    x, a, b = sp.symbols("x a b")
    expected = (x + a + b) * x

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == LENGTH**2
    assert sp.simplify(result.expression - expected) == 0


def test_global_variable_dimension_error_in_deep_chain():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.set_symbolic_variable("t", "t", TIME)
    engine.lines = [
        "f(x) = x + t",
        "g(x) = f(x)**2",
        "h(x) = g(x) + x**2",
    ]
    engine._rebuild()

    with pytest.raises(DimensionError):
        engine.call("h", engine.variables.get("x"))


def test_deep_chain_differentiation():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.lines = [
        "f(x) = x**2",
        "g(x) = f(x)**2",
        "h(x) = g(x) * x",
    ]
    engine._rebuild()

    result = engine.differentiate("h(x)", "x")

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == LENGTH**4
    assert sp.simplify(
        result.expression - 5 * sp.Symbol("x")**4
    ) == 0


def test_deep_chain_integration():
    engine = MathEngine()
    engine.set_symbolic_variable("t", "t", TIME)
    engine.lines = [
        "f(t) = t**2",
        "g(t) = f(t) * t",
        "h(t) = g(t) + t**3",
    ]
    engine._rebuild()

    result = engine.integrate("h(t)", variable="t")

    assert isinstance(result, SymbolicQuantity)
    assert result.dimension == TIME**4
    assert sp.simplify(
        result.expression - sp.Rational(1, 2) * sp.Symbol("t")**4
    ) == 0


def test_nested_chain_with_mixed_dimensions():
    engine = MathEngine()
    engine.set_symbolic_variable("x", "x", LENGTH)
    engine.set_symbolic_variable("t", "t", TIME)
    engine.lines = [
        "velocity(x, t) = x / t",
        "square(x, t) = velocity(x, t)**2",
        "result(x, t) = square(x, t) * t",
    ]
    engine._rebuild()

    value = engine.call(
        "result",
        engine.variables.get("x"),
        engine.variables.get("t"),
    )

    assert isinstance(value, SymbolicQuantity)
    assert value.dimension == LENGTH**2 / TIME
